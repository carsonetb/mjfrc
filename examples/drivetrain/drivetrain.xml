<mujoco>
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.001" integrator="RK4" cone="elliptic"/>

  <default>
    <default class="visual">
      <geom type="mesh" group="2" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom type="mesh" group="3"/>
    </default>
  </default>

  <worldbody>
    <body name="drivetrain" pos="0 0 0.5">
      <!-- <joint type="free" /> -->
      <inertial pos="0 0 0" mass="30" diaginertia="5 5 5"/>
      <site name="gyro_site" />

      <!-- Bumper -->
      <geom type="box" pos="-0.3944685 0 0.1075" size="0.009525 0.403225 0.0635" rgba="0.8 0.776470588 0.71372549 1" />
      <geom type="box" pos="0.3944685 0 0.1075" size="0.009525 0.403225 0.0635" rgba="0.8 0.776470588 0.71372549 1" />
      <geom type="box" pos="-0.294462 -0.3944685 0.1075" size="0.0905 0.009525 0.0635" rgba="0.8 0.776470588 0.71372549 1" />
      <geom type="box" pos="0.294462 -0.3944685 0.1075" size="0.0905 0.009525 0.0635" rgba="0.8 0.776470588 0.71372549 1" />
      <geom type="box" pos="-0.194437 0.3944685 0.1075" size="0.1905 0.009525 0.0635" rgba="0.8 0.776470588 0.71372549 1" />
      <geom type="box" pos="0.194437 0.3944685 0.1075" size="0.1905 0.009525 0.0635" rgba="0.8 0.776470588 0.71372549 1" />

      <!-- Boxtube -->
      <geom type="box" pos="-0.2159 -0.27305 0.073025" size="0.0127 0.10795 0.028575" rgba="0.647058824 0.647058824 0.647058824 1" />
      <geom type="box" pos="0.2159 -0.27305 0.073025" size="0.0127 0.10795 0.028575" rgba="0.647058824 0.647058824 0.647058824 1" />
      <geom type="box" pos="0 -0.1524 0.073025" size="0.228611025 0.0127 0.028575" rgba="0.647058824 0.647058824 0.647058824 1" />

      <!-- Wheels -->

      <!-- Front left -->
      <body pos="0.3145 -0.3145 0.051">
        <inertial pos="0 0 0" mass="0.71795491" diaginertia="0.001 0.001 0.001" />
        <joint type="slide" axis="0 0 1" stiffness="50000" damping="1000" pos="0 0 0" springref="0"/>
        <joint name="FrontLeftTurningMotor" type="hinge" axis="0 0 1" armature="0.034" damping="3.2" />
        <body>
          <inertial pos="0 0 0" mass="0.5440369" diaginertia="0.001 0.001 0.001" />
          <joint name="FrontLeftDrivingMotor" type="hinge" axis="0 1 0" armature="0.00139" damping="0.66" />
          <geom type="sphere" size="0.0508" friction="1.2 0.005 0.0001" class="collision" />
          <geom type="cylinder" size="0.0508 0.02" pos="0 0 0" euler="90 0 0" class="visual" />
          <geom type="cylinder" size="0.003 0.06" pos="0 0 0" euler="0 0 0" class="visual" />
        </body>
      </body>

      <!-- Back left -->
      <body pos="0.3145 0.3145 0.051">
        <inertial pos="0 0 0" mass="0.71795491" diaginertia="0.001 0.001 0.001" />
        <joint type="slide" axis="0 0 1" stiffness="50000" damping="1000" pos="0 0 0" springref="0" />
        <joint name="BackLeftTurningMotor" type="hinge" axis="0 0 1" armature="0.034" damping="3.2" />
        <body>
          <inertial pos="0 0 0" mass="0.5440369" diaginertia="0.001 0.001 0.001" />
          <joint name="BackLeftDrivingMotor" type="hinge" axis="0 1 0" armature="0.00139" damping="0.66" />
          <geom type="sphere" size="0.0508" friction="1.2 0.005 0.0001" class="collision" />
          <geom type="cylinder" size="0.0508 0.02" pos="0 0 0" euler="90 0 0" class="visual" />
          <geom type="cylinder" size="0.003 0.06" pos="0 0 0" euler="0 0 0" class="visual" />
        </body>
      </body>

       <!-- Front right -->
      <body pos="-0.3145 -0.3145 0.051">
        <inertial pos="0 0 0" mass="0.71795491" diaginertia="0.001 0.001 0.001" />
        <joint type="slide" axis="0 0 1" stiffness="50000" damping="1000" pos="0 0 0" springref="0"/>
        <joint name="FrontRightTurningMotor" type="hinge" axis="0 0 1" armature="0.034" damping="3.2" />
        <body>
          <inertial pos="0 0 0" mass="0.5440369" diaginertia="0.001 0.001 0.001" />
          <joint name="FrontRightDrivingMotor" type="hinge" axis="0 1 0" armature="0.00139" damping="0.66" />
          <geom type="sphere" size="0.0508" friction="1.2 0.005 0.0001" class="collision" />
          <geom type="cylinder" size="0.0508 0.02" pos="0 0 0" euler="90 0 0" class="visual" />
          <geom type="cylinder" size="0.003 0.06" pos="0 0 0" euler="0 0 0" class="visual" />
        </body>
      </body>

      <!-- Back right -->
      <body pos="-0.3145 0.3145 0.051">
        <inertial pos="0 0 0" mass="0.71795491" diaginertia="0.001 0.001 0.001" />
        <joint type="slide" axis="0 0 1" stiffness="50000" damping="1000" pos="0 0 0" springref="0"/>
        <joint name="BackRightTurningMotor" type="hinge" axis="0 0 1" armature="0.034" damping="3.2" />
        <body>
          <inertial pos="0 0 0" mass="0.5440369" diaginertia="0.001 0.001 0.001" />
          <joint name="BackRightDrivingMotor" type="hinge" axis="0 1 0" armature="0.00139" damping="0.66" />
          <geom type="sphere" size="0.0508" friction="1.2 0.005 0.0001" class="collision" />
          <geom type="cylinder" size="0.0508 0.02" pos="0 0 0" euler="90 0 0" class="visual" />
          <geom type="cylinder" size="0.003 0.06" pos="0 0 0" euler="0 0 0" class="visual" />
        </body>
      </body>

    </body>

    <geom name="floor" type="plane" pos="0 0 0" size="0 0 2" material="groundplane" euler="0 0 0" />

    <light pos="0 0 1.5" dir="-1 -1 -1" type="directional" />
    <light pos="0 0 1.5" dir="0 0 -1" range="30.0" />
  </worldbody>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="300" height="300" mark="edge" markrgb=".8 .8 .8"/>
    <material name="groundplane" texture="groundplane" texrepeat="5 5" texuniform="true" reflectance="0.2"/>
  </asset>

  <sensor>
    <gyro name="*:20" site="gyro_site" />
  </sensor>

  <actuator>
    <dcmotor name="*:1" joint="FrontLeftDrivingMotor" gear="26.09" ctrlrange="-12.0 12.0" resistance="0.0364741641" motorconst="0.0152279635 0.00205638822" />
    <dcmotor name="*:2" joint="BackLeftDrivingMotor" gear="26.09" ctrlrange="-12.0 12.0" resistance="0.0364741641" motorconst="0.0152279635 0.00205638822" />
    <dcmotor name="*:3" joint="BackRightDrivingMotor" gear="26.09" ctrlrange="-12.0 12.0" resistance="0.0364741641" motorconst="0.0152279635 0.00205638822" />
    <dcmotor name="*:4" joint="FrontRightDrivingMotor" gear="26.09" ctrlrange="-12.0 12.0" resistance="0.0364741641" motorconst="0.0152279635 0.00205638822" />
  </actuator>

</mujoco>
